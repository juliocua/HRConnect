generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id         String       @id @default(cuid())
  email      String       @unique
  password   String?
  name       String
  role       UserRole     @default(HR_STAFF)
  provider   AuthProvider @default(LOCAL)
  providerId String?
  avatarUrl  String?
  isActive   Boolean      @default(true)
  employeeId String?      @unique
  employee   Employee?    @relation(fields: [employeeId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  HR_MANAGER
  HR_STAFF
  EMPLOYEE
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

// ── Organization ──────────────────────────────────────────────────────────────

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]

  @@map("departments")
}

// ── Employees ─────────────────────────────────────────────────────────────────

model Employee {
  id           String         @id @default(cuid())
  employeeNo   String         @unique
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  position     String
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  managerId    String?
  manager      Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates Employee[]     @relation("EmployeeManager")
  status       EmployeeStatus @default(ACTIVE)
  hireDate     DateTime       @db.Date
  basicSalary  Float
  sssNo        String?
  philhealthNo String?
  pagibigNo    String?
  tinNo        String?
  gender       Gender?
  avatarColor  String         @default("#2563EB")
  photoUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  resourceCost   Float?
  payrollCost    Float?
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])

  attendance       Attendance[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]
  payrollRecords   PayrollRecord[]
  overtimeRequests OvertimeRequest[]
  user             User?

  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ── Clients ───────────────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  name            String
  address         String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  servicesOffered String?
  specificRequest String?      @db.Text
  billingCycle    BillingCycle @default(MONTHLY)
  billingDate     Int?
  payPeriodType   Int?
  adminFeeRate    Float?
  isVatable       Boolean      @default(false)
  hasEwt          Boolean      @default(false)
  billingTerms    String?
  activeContract  Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  policies  ClientPolicy[]
  billings  Billing[]
  employees Employee[]

  @@map("clients")
}

enum BillingCycle {
  WEEKLY
  EVERY_15TH
  EVERY_30TH
  MONTHLY
}

model ClientPolicy {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String   @db.Text
  value       String?  // structured value for special types (e.g. EMPLOYEE_PAY_PERIOD: '1','2','7','9')
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_policies")
}

model Billing {
  id                   String        @id @default(cuid())
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  billingDate          DateTime
  dueDate              DateTime?
  amount               Float
  status               BillingStatus @default(PENDING)
  paidAt               DateTime?
  paymentRef           String?
  paymentScreenshotUrl String?
  paymentLinkId        String?
  paymentLinkUrl       String?
  notes                String?
  lineItems            Json?         // [{ description: string, amount: number }]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("billings")
}

enum BillingStatus {
  PENDING
  PAID
  CANCELLED
}

// ── Attendance ────────────────────────────────────────────────────────────────

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime         @db.Date
  timeIn      DateTime?
  timeOut     DateTime?
  status      AttendanceStatus
  overtimeHrs     Float            @default(0)
  notes           String?
  isManualEntry   Boolean          @default(false)
  manualReason    String?
  clockInAt       DateTime?
  clockOutAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

// ── Leave ─────────────────────────────────────────────────────────────────────

model LeaveType {
  id               String  @id @default(cuid())
  code             String  @unique
  name             String
  daysPerYear      Int
  isPaid           Boolean @default(true)
  legalBasis       String?
  // Gender restriction: ALL | MALE | FEMALE
  applicableGender String  @default("ALL")
  // Whether balance resets every Jan 1 (VL, SL, EL = true; SIL = false)
  resetsAnnually   Boolean @default(true)
  // Whether days accrue monthly (daysPerYear/12 per month) vs granted upfront
  accruesMonthly   Boolean @default(false)
  // Whether allocation is set manually per employee (SIL)
  isManual         Boolean @default(false)
  isActive         Boolean @default(true)

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  totalDays      Int
  reason         String?
  status         LeaveStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNote  String?
  filedAt        DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Float
  usedDays    Float     @default(0)
  pendingDays Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

// ── Overtime ──────────────────────────────────────────────────────────────────

model OvertimeRequest {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  attendanceId   String?
  date           DateTime  @db.Date
  hours          Float
  reason         String?
  status         OTStatus  @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNote  String?
  filedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("overtime_requests")
}

enum OTStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Payroll ───────────────────────────────────────────────────────────────────

model PayrollRun {
  id            String        @id @default(cuid())
  period        String        // e.g. "2026-09 · Type 1" or "Christmas Bonus 2026"
  year          Int
  month         Int
  payPeriodType Int           @default(1)  // 1=semi-monthly 1st, 2=semi-monthly 2nd, 7=special, 9=13th month
  description   String?       // label for type 7 and 9
  periodStart   DateTime      @db.Date
  periodEnd     DateTime      @db.Date
  status        PayrollStatus @default(DRAFT)
  runById       String
  runAt         DateTime      @default(now())
  records       PayrollRecord[]

  @@map("payroll_runs")
}

enum PayrollStatus {
  DRAFT
  POSTED
  PAID
}

model PayrollRecord {
  id                String     @id @default(cuid())
  payrollRunId      String
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId        String
  employee          Employee   @relation(fields: [employeeId], references: [id])
  basicSalary       Float
  grossPay          Float
  sssContrib        Float
  philhealthContrib Float
  pagibigContrib    Float
  taxableIncome     Float
  withholdingTax    Float
  totalDeductions   Float
  netPay            Float
  daysWorked        Float      @default(0)
  overtimePay       Float      @default(0)
  allowances        Float      @default(0)
  otherDeductions   Float      @default(0)

  @@unique([payrollRunId, employeeId])
  @@map("payroll_records")
}
