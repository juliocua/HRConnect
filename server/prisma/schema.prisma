generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id         String       @id @default(cuid())
  email      String       @unique
  password   String?
  name       String
  role       UserRole     @default(HR_STAFF)
  provider   AuthProvider @default(LOCAL)
  providerId String?
  avatarUrl  String?
  isActive   Boolean      @default(true)
  employeeId String?      @unique
  employee   Employee?    @relation(fields: [employeeId], references: [id])
  companyId  String?
  company    Company?     @relation(fields: [companyId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  HR_MANAGER
  HR_STAFF
  EMPLOYEE
  EMPLOYEE_RELATIONS
  ACCOUNTS_MANAGEMENT
  BILLING_COLLECTION
  ACCOUNTING
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

// ── OTP ───────────────────────────────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

// ── Organization ──────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("companies")
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]

  @@map("departments")
}

// ── Employees ─────────────────────────────────────────────────────────────────

model Employee {
  id           String         @id @default(cuid())
  employeeNo   String         @unique
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  position     String
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  managerId    String?
  manager      Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates Employee[]     @relation("EmployeeManager")
  status       EmployeeStatus @default(ACTIVE)
  hireDate     DateTime       @db.Date
  basicSalary  Float
  sssNo        String?
  philhealthNo String?
  pagibigNo    String?
  tinNo        String?
  gender       Gender?
  avatarColor  String         @default("#2563EB")
  photoUrl     String?
  address      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  resourceCost   Float?
  payrollCost    Float?
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])
  branchId       String?
  branch         ClientBranch?  @relation(fields: [branchId], references: [id])

  bankName        String?
  bankAccountNo   String?
  bankAccountName String?

  dailyRate    Float?
  useDailyRate Boolean @default(false)

  attendance              Attendance[]
  leaveRequests           LeaveRequest[]
  leaveBalances           LeaveBalance[]
  payrollRecords          PayrollRecord[]
  overtimeRequests        OvertimeRequest[]
  profileChangeRequests   ProfileChangeRequest[]
  attendanceEditRequests  AttendanceEditRequest[]
  govIdChangeRequests     GovIdChangeRequest[]
  documents               EmployeeDocument[]
  assignments             EmployeeAssignment[]
  user                    User?
  expenseRequests         ExpenseRequest[]
  approvedExpenses        ExpenseRequest[]       @relation("ExpenseApprovals")

  @@map("employees")
}

// ── Employee Documents (201 File) ─────────────────────────────────────────────

model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  size         Int
  category     String?
  uploadedById String
  createdAt    DateTime @default(now())

  @@map("employee_documents")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ── Profile Change Requests ───────────────────────────────────────────────────

model ProfileChangeRequest {
  id            String              @id @default(cuid())
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id])
  changes       Json
  status        ProfileChangeStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String?
  submittedAt   DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("profile_change_requests")
}

// ── Gov ID Change Requests ────────────────────────────────────────────────────

model GovIdChangeRequest {
  id            String              @id @default(cuid())
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id])
  sssNo         String?
  philhealthNo  String?
  pagibigNo     String?
  tinNo         String?
  status        ProfileChangeStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String?
  submittedAt   DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("gov_id_change_requests")
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Audit Log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  performedById String
  performedAt   DateTime @default(now())
  before        Json?
  after         Json?

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ── Clients ───────────────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  name            String
  address         String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  servicesOffered String?
  specificRequest String?      @db.Text
  billingCycle    BillingCycle @default(MONTHLY)
  billingDate         Int?
  biMonthlyH1CutFrom  Int?   // First half: cut-off start day (1–31)
  biMonthlyH1CutTo    Int?   // First half: cut-off end day
  biMonthlyH1BillDay  Int?   // First half: bill date (day of month)
  biMonthlyH2CutFrom  Int?   // Second half: cut-off start day
  biMonthlyH2CutTo    Int?   // Second half: cut-off end day
  biMonthlyH2BillDay  Int?   // Second half: bill date (day of month)
  payPeriodType   Int?
  adminFeeRate    Float?
  isVatable       Boolean      @default(false)
  hasEwt          Boolean      @default(false)
  billingTerms    String?
  activeContract          Boolean      @default(true)
  clientSignatoryName     String?
  clientSignatoryTitle    String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  policies            ClientPolicy[]
  branches            ClientBranch[]
  billings            Billing[]
  employees           Employee[]
  employeeAssignments EmployeeAssignment[]

  @@map("clients")
}

enum BillingCycle {
  WEEKLY
  EVERY_15TH
  EVERY_30TH
  MONTHLY
  BI_MONTHLY
}

model ClientPolicy {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String   @db.Text
  value       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_policies")
}

model ClientBranch {
  id          String       @id @default(cuid())
  clientId    String
  name        String
  address     String?
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employees   Employee[]
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("client_branches")
}

model Billing {
  id                   String        @id @default(cuid())
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  billingDate          DateTime
  dueDate              DateTime?
  amount               Float
  status               BillingStatus @default(PENDING)
  paidAt               DateTime?
  paymentRef           String?
  paymentScreenshotUrl String?
  soaNo                String?
  grossBill            Float?
  vatAmount            Float?
  ewtAmount            Float?
  totalNetBill         Float?
  amountPaid           Float?
  serviceInvoiceNo     String?
  paymentLinkId        String?
  paymentLinkUrl       String?
  notes                String?
  lineItems            Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("billings")
}

enum BillingStatus {
  PENDING
  PAID
  CANCELLED
}

// ── Employee Assignment History ───────────────────────────────────────────────

model EmployeeAssignment {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clientId   String?
  client     Client?        @relation(fields: [clientId], references: [id])
  type       AssignmentType
  startDate  DateTime       @db.Date
  endDate    DateTime?      @db.Date
  notes      String?
  createdAt  DateTime       @default(now())

  @@map("employee_assignments")
}

enum AssignmentType {
  DEPLOYED
  RTA
  TRANSFERRED
}

// ── Attendance ────────────────────────────────────────────────────────────────

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime         @db.Date
  timeIn      DateTime?
  timeOut     DateTime?
  status      AttendanceStatus
  overtimeHrs     Float            @default(0)
  lateMinutes     Float            @default(0)
  notes           String?
  isManualEntry   Boolean          @default(false)
  manualReason    String?
  clockInAt       DateTime?
  clockOutAt      DateTime?
  branchId        String?
  branch          ClientBranch?    @relation(fields: [branchId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

// ── Attendance Edit Requests ──────────────────────────────────────────────────

model AttendanceEditRequest {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  attendanceDate   DateTime  @db.Date
  requestedTimeIn  DateTime?
  requestedTimeOut DateTime?
  requestedStatus  String?
  reason           String
  attachmentUrl    String?
  status           String    @default("PENDING")
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionNote    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("attendance_edit_requests")
}

// ── Leave ─────────────────────────────────────────────────────────────────────

model LeaveType {
  id               String  @id @default(cuid())
  code             String  @unique
  name             String
  daysPerYear      Int
  isPaid           Boolean @default(true)
  legalBasis       String?
  applicableGender String  @default("ALL")
  resetsAnnually   Boolean @default(true)
  accruesMonthly   Boolean @default(false)
  isManual         Boolean @default(false)
  isActive         Boolean @default(true)

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  totalDays      Int
  reason         String?
  status         LeaveStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNote  String?
  filedAt        DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Float
  usedDays    Float     @default(0)
  pendingDays Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

// ── Overtime ──────────────────────────────────────────────────────────────────

model OvertimeRequest {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  attendanceId   String?
  date           DateTime  @db.Date
  hours          Float
  reason         String?
  status         OTStatus  @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNote  String?
  filedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("overtime_requests")
}

enum OTStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Payroll ───────────────────────────────────────────────────────────────────

model PayrollRun {
  id            String        @id @default(cuid())
  period        String
  year          Int
  month         Int
  payPeriodType Int           @default(1)
  description   String?
  periodStart   DateTime      @db.Date
  periodEnd     DateTime      @db.Date
  status        PayrollStatus @default(DRAFT)
  runById       String
  runAt         DateTime      @default(now())
  records       PayrollRecord[]

  @@map("payroll_runs")
}

enum PayrollStatus {
  DRAFT
  POSTED
  PAID
}

model PayrollRecord {
  id                String     @id @default(cuid())
  payrollRunId      String
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId        String
  employee          Employee   @relation(fields: [employeeId], references: [id])
  basicSalary       Float
  grossPay          Float
  sssContrib        Float
  philhealthContrib Float
  pagibigContrib    Float
  taxableIncome     Float
  withholdingTax    Float
  totalDeductions   Float
  netPay            Float
  daysWorked        Float      @default(0)
  overtimePay       Float      @default(0)
  allowances        Float      @default(0)
  otherDeductions     Float      @default(0)
  otherDeductionsNote String?
  lateDeduction       Float      @default(0)
  holidayPay          Float      @default(0)
  nightDifferential   Float      @default(0)
  nightDiffHours      Float      @default(0)
  silPay              Float      @default(0)
  expenses            ExpenseRequest[]

  @@unique([payrollRunId, employeeId])
  @@map("payroll_records")
}

// ── Holidays ──────────────────────────────────────────────────────────────────

model Holiday {
  id        String      @id @default(cuid())
  date      DateTime    @db.Date
  name      String
  type      HolidayType
  year      Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([date])
  @@map("holidays")
}

enum HolidayType {
  REGULAR
  SPECIAL_NON_WORKING
  SPECIAL_WORKING
}

// ── Global Setup ──────────────────────────────────────────────────────────────

model CutOffPeriod {
  id                    String               @id @default(cuid())
  name                  String
  cutOffFromDay         Int
  cutOffFromIsPrevMonth Boolean              @default(false)
  cutOffToDay           Int
  payDay                Int
  payDayIsNextMonth     Boolean              @default(false)
  sortOrder             Int                  @default(0)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  globalPayrollPolicies GlobalPayrollPolicy[]

  @@map("cut_off_periods")
}

model GlobalPayrollPolicy {
  id              String        @id @default(cuid())
  type            String        @unique
  cutOffPeriodId  String?
  splitHalf       Boolean       @default(false)
  cutOffPeriod    CutOffPeriod? @relation(fields: [cutOffPeriodId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("global_payroll_policies")
}

model CompanySettings {
  id                String   @id @default("singleton")
  companyName       String   @default("")
  address           String?
  taxNumber         String?
  contactNumber     String?
  logoUrl           String?
  defaultShiftStart String?  @default("08:00")
  defaultShiftEnd   String?  @default("17:00")
  // Admin fee (global)
  adminFeeType      String?
  adminFeeValue     Float?
  adminFeeTiers     Json?
  // SOA signatories (company side)
  signatoryName     String?
  signatoryTitle    String?
  // Pay computation rates
  overtimeRate          Float?   @default(1.25)
  nightDifferentialRate Float?   @default(0.10)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("company_settings")
}

// ── App Settings ──────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ── Expense Reimbursements ────────────────────────────────────────────────────

model ExpenseCategory {
  id        String           @id @default(cuid())
  name      String
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  expenses  ExpenseRequest[]

  @@map("expense_categories")
}

model ExpenseRequest {
  id              String           @id @default(cuid())
  employeeId      String
  employee        Employee         @relation(fields: [employeeId], references: [id])
  categoryId      String?
  category        ExpenseCategory? @relation(fields: [categoryId], references: [id])
  description     String
  amount          Float
  receiptUrl      String?
  status          ExpenseStatus    @default(PENDING)
  approvedById    String?
  approvedBy      Employee?        @relation("ExpenseApprovals", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionNote   String?
  payrollRecordId String?
  payrollRecord   PayrollRecord?   @relation(fields: [payrollRecordId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("expense_requests")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}
