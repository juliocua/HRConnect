generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id         String       @id @default(cuid())
  email      String       @unique
  password   String?
  name       String
  role       UserRole     @default(HR_STAFF)
  provider   AuthProvider @default(LOCAL)
  providerId String?
  avatarUrl  String?
  isActive   Boolean      @default(true)
  employeeId String?      @unique
  employee   Employee?    @relation(fields: [employeeId], references: [id])
  companyId  String?
  company    Company?     @relation(fields: [companyId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  HR_MANAGER
  HR_STAFF
  EMPLOYEE
}

enum AuthProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

// ── OTP ───────────────────────────────────────────────────────────────────────

model OtpCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

// ── Organization ──────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("companies")
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  employees Employee[]

  @@map("departments")
}

// ── Employees ─────────────────────────────────────────────────────────────────

model Employee {
  id           String         @id @default(cuid())
  employeeNo   String         @unique
  firstName    String
  lastName     String
  email        String         @unique
  phone        String?
  position     String
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id])
  managerId    String?
  manager      Employee?      @relation("EmployeeManager", fields: [managerId], references: [id])
  subordinates Employee[]     @relation("EmployeeManager")
  status       EmployeeStatus @default(ACTIVE)
  hireDate     DateTime       @db.Date
  basicSalary  Float
  sssNo        String?
  philhealthNo String?
  pagibigNo    String?
  tinNo        String?
  gender       Gender?
  avatarColor  String         @default("#2563EB")
  photoUrl     String?
  address      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  resourceCost   Float?
  payrollCost    Float?
  clientId       String?
  client         Client?        @relation(fields: [clientId], references: [id])

  bankName        String?
  bankAccountNo   String?
  bankAccountName String?

  attendance              Attendance[]
  leaveRequests           LeaveRequest[]
  leaveBalances           LeaveBalance[]
  payrollRecords          PayrollRecord[]
  overtimeRequests        OvertimeRequest[]
  profileChangeRequests   ProfileChangeRequest[]
  attendanceEditRequests  AttendanceEditRequest[]
  govIdChangeRequests     GovIdChangeRequest[]
  user                    User?

  @@map("employees")
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ── Profile Change Requests ───────────────────────────────────────────────────

model ProfileChangeRequest {
  id            String              @id @default(cuid())
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id])
  changes       Json
  status        ProfileChangeStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String?
  submittedAt   DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("profile_change_requests")
}

// ── Gov ID Change Requests ────────────────────────────────────────────────────

model GovIdChangeRequest {
  id            String              @id @default(cuid())
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id])
  sssNo         String?
  philhealthNo  String?
  pagibigNo     String?
  tinNo         String?
  status        ProfileChangeStatus @default(PENDING)
  reviewedById  String?
  reviewedAt    DateTime?
  rejectionNote String?
  submittedAt   DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("gov_id_change_requests")
}

enum ProfileChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Audit Log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  action        String
  performedById String
  performedAt   DateTime @default(now())
  before        Json?
  after         Json?

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ── Clients ───────────────────────────────────────────────────────────────────

model Client {
  id              String       @id @default(cuid())
  name            String
  address         String?
  contactName     String?
  contactEmail    String?
  contactPhone    String?
  servicesOffered String?
  specificRequest String?      @db.Text
  billingCycle    BillingCycle @default(MONTHLY)
  billingDate     Int?
  payPeriodType   Int?
  adminFeeRate    Float?
  isVatable       Boolean      @default(false)
  hasEwt          Boolean      @default(false)
  billingTerms    String?
  activeContract  Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  policies  ClientPolicy[]
  billings  Billing[]
  employees Employee[]

  @@map("clients")
}

enum BillingCycle {
  WEEKLY
  EVERY_15TH
  EVERY_30TH
  MONTHLY
}

model ClientPolicy {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  description String   @db.Text
  value       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("client_policies")
}

model Billing {
  id                   String        @id @default(cuid())
  clientId             String
  client               Client        @relation(fields: [clientId], references: [id])
  billingDate          DateTime
  dueDate              DateTime?
  amount               Float
  status               BillingStatus @default(PENDING)
  paidAt               DateTime?
  paymentRef           String?
  paymentScreenshotUrl String?
  paymentLinkId        String?
  paymentLinkUrl       String?
  notes                String?
  lineItems            Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@map("billings")
}

enum BillingStatus {
  PENDING
  PAID
  CANCELLED
}

// ── Attendance ────────────────────────────────────────────────────────────────

model Attendance {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id])
  date        DateTime         @db.Date
  timeIn      DateTime?
  timeOut     DateTime?
  status      AttendanceStatus
  overtimeHrs     Float            @default(0)
  notes           String?
  isManualEntry   Boolean          @default(false)
  manualReason    String?
  clockInAt       DateTime?
  clockOutAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([employeeId, date])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

// ── Attendance Edit Requests ──────────────────────────────────────────────────

model AttendanceEditRequest {
  id               String    @id @default(cuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  attendanceDate   DateTime  @db.Date
  requestedTimeIn  DateTime?
  requestedTimeOut DateTime?
  requestedStatus  String?
  reason           String
  attachmentUrl    String?
  status           String    @default("PENDING")
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionNote    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("attendance_edit_requests")
}

// ── Leave ─────────────────────────────────────────────────────────────────────

model LeaveType {
  id               String  @id @default(cuid())
  code             String  @unique
  name             String
  daysPerYear      Int
  isPaid           Boolean @default(true)
  legalBasis       String?
  applicableGender String  @default("ALL")
  resetsAnnually   Boolean @default(true)
  accruesMonthly   Boolean @default(false)
  isManual         Boolean @default(false)
  isActive         Boolean @default(true)

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id             String      @id @default(cuid())
  employeeId     String
  employee       Employee    @relation(fields: [employeeId], references: [id])
  leaveTypeId    String
  leaveType      LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  totalDays      Int
  reason         String?
  status         LeaveStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNote  String?
  filedAt        DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  totalDays   Float
  usedDays    Float     @default(0)
  pendingDays Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

// ── Overtime ──────────────────────────────────────────────────────────────────

model OvertimeRequest {
  id             String    @id @default(cuid())
  employeeId     String
  employee       Employee  @relation(fields: [employeeId], references: [id])
  attendanceId   String?
  date           DateTime  @db.Date
  hours          Float
  reason         String?
  status         OTStatus  @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNote  String?
  filedAt        DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("overtime_requests")
}

enum OTStatus {
  PENDING
  APPROVED
  REJECTED
}

// ── Payroll ───────────────────────────────────────────────────────────────────

model PayrollRun {
  id            String        @id @default(cuid())
  period        String
  year          Int
  month         Int
  payPeriodType Int           @default(1)
  description   String?
  periodStart   DateTime      @db.Date
  periodEnd     DateTime      @db.Date
  status        PayrollStatus @default(DRAFT)
  runById       String
  runAt         DateTime      @default(now())
  records       PayrollRecord[]

  @@map("payroll_runs")
}

enum PayrollStatus {
  DRAFT
  POSTED
  PAID
}

model PayrollRecord {
  id                String     @id @default(cuid())
  payrollRunId      String
  payrollRun        PayrollRun @relation(fields: [payrollRunId], references: [id])
  employeeId        String
  employee          Employee   @relation(fields: [employeeId], references: [id])
  basicSalary       Float
  grossPay          Float
  sssContrib        Float
  philhealthContrib Float
  pagibigContrib    Float
  taxableIncome     Float
  withholdingTax    Float
  totalDeductions   Float
  netPay            Float
  daysWorked        Float      @default(0)
  overtimePay       Float      @default(0)
  allowances        Float      @default(0)
  otherDeductions   Float      @default(0)
  lateDeduction     Float      @default(0)
  holidayPay        Float      @default(0)
  nightDifferential Float      @default(0)

  @@unique([payrollRunId, employeeId])
  @@map("payroll_records")
}
