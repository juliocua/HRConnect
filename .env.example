# ── Database ─────────────────────────────────────────────────────────────────
# Railway auto-populates DATABASE_URL when you add a PostgreSQL plugin
DATABASE_URL="postgresql://user:password@localhost:5432/hrconnect"

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=3001
CLIENT_URL="http://localhost:5173"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="change-this-too"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Microsoft OAuth ───────────────────────────────────────────────────────────
# Create at: https://portal.azure.com → App registrations
# Redirect URI: http://localhost:3001/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
