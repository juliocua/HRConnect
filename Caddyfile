# ── HRConnect Caddyfile ───────────────────────────────────────────────────────
#
# Replace the domain below with your actual domain or subdomain.
#
# SCENARIO A — Public domain with auto-HTTPS (Let's Encrypt)
#   Requirements: server has a public IP, DNS A record points to it, port 80+443 open
#   Example: hris.clientname.com
#
# SCENARIO B — Intranet domain (no internet access needed)
#   Requirements: client's IT sets an internal DNS record pointing to this server's IP
#   Use http:// prefix to disable TLS (Caddy won't attempt Let's Encrypt for .local domains)
#   Example: http://hris.clientname.local
#
# ─────────────────────────────────────────────────────────────────────────────

# Change this line to match your domain:
hris.clientname.com {

    # Forward all traffic to the nginx/client container
    reverse_proxy client:80

    # Optional: enable request logging
    log {
        output stdout
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# For INTRANET use, replace the block above with:
#
# http://hris.clientname.local {
#     reverse_proxy client:80
# }
# ─────────────────────────────────────────────────────────────────────────────
